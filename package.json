{
  "name": "monaddraw",
  "version": "0.1.0",
  "private": true,
  "description": "MonadDraw contracts + API backend (testnet demo, not production)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:api": "mocha test-api --timeout 120000",
    "test:all": "npm run test && npm run test:api && npm run test:frontend && npm run test:chain-local",
    "test:chain-local": "node --experimental-strip-types --test src/services/chain.local.test.ts",
    "node": "hardhat node",
    "deploy:demo": "hardhat run scripts/deploy-demo.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.js --network monadTestnet",
    "start": "node server/index.js",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "nodemon server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:frontend": "node --experimental-strip-types --test src/services/draw.test.ts src/services/events.test.ts src/services/chain.test.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^1.48.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.6",
    "nodemon": "^3.1.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/node": "^24.13.3"
  }
}
